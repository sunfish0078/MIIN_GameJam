      m_Calls: []
  m_text: "\uB2F9\uC2E0\uC740 \uC774 \uAC74\uBB3C\uC758 \uACBD\uBE44\uC6D0 \uC785\uB2C8\uB2E4.\r\n\uB2F9\uC2E0\uC740
    \uC774\uC0C1\uD604\uC0C1\uC744 \uCC98\uB9AC\uD560 \uC218 \uC788\uB294 \uD2B9\uBCC4\uD55C
    \uCE74\uBA54\uB77C\uB97C \uC5BB\uC5C8\uC2B5\uB2C8\uB2E4.\r\n\uC544\uC774\uB4E4\uC758
    \uBB3C\uAC74\uC744 \uCC0D\uACE0, \uADF8 \uC544\uC774\uB4E4\uC758 \uC2DC\uAC04\uB300\uB85C
    \uC774\uB3D9\uD558\uC138\uC694.\r\n\uADF8 \uACF5\uAC04 \uC548\uC5D0\uC11C \uC774\uC0C1\uD604\uC0C1\uC744
    \uCC98\uB9AC\uD558\uC138\uC694.\r\n\r\n\uC774\uC0C1\uD604\uC0C1\uC740 \uCE74\uBA54\uB77C\uC5D0
    \uC804\uBD80 \uB2F4\uACA8\uC57C \uCC98\uB9AC\uD560\uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uADF8\uAC83\uB4E4\uC744
    \uBE68\uB9AC \uCC98\uB9AC\uD558\uB294 \uAC83\uC774 \uC88B\uC744 \uAC70\uC608\uC694.\r\n\r\n\uC774\uC0C1\uD604\uC0C1
    \uC0AC\uC774\uC5D0 \uB2F9\uC2E0\uC744 \uCAD3\uC544\uC624\uB294 \uBB34\uC5B8\uAC00\uAC00
    \uC544\uC774\uC785\uB2C8\uB2E4.\r\n\uCE74\uBA54\uB77C\uC758 \uD06C\uAE30\uB97C
    \uCD5C\uB300\uD55C \uC904\uC5EC \uACF5\uACA9\uD558\uC138\uC694. "
